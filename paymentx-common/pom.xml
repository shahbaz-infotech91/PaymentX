<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.paymentx</groupId>
        <artifactId>paymentx-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>paymentx-common</artifactId>
    <packaging>jar</packaging>
    <name>PaymentX Common</name>
    <description>Shared event contracts, DTOs, exceptions, and cross-cutting config. NO business logic allowed here.</description>

    <dependencies>
        <!-- Just enough to define contracts - NOT spring-boot-starter-web.
             common must stay lightweight; it should never pull in a servlet
             container transitively into every consuming service. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <!--
            provided scope: CorrelationIdFilter needs jakarta.servlet.* to COMPILE,
            but common should NOT force every consuming service to have an embedded
            servlet container. Services that already pull in spring-boot-starter-web
            (which brings Tomcat + this same servlet API) satisfy this at runtime
            automatically. A hypothetical future non-web service (e.g. a pure Kafka
            consumer with no HTTP endpoints) could depend on common WITHOUT
            accidentally getting a Tomcat instance it never needed.
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--
            spring-web gives us OncePerRequestFilter (used by CorrelationIdFilter).
            Like servlet-api above, this is a lean, targeted dependency -
            NOT the full spring-boot-starter-web, which would also drag in
            Tomcat, Jackson auto-config, and MVC auto-configuration that
            `common` has no business owning.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>
</project>
